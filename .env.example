# LLM Provider: "mock" (offline deterministic demo) | "openai" (any OpenAI-compatible endpoint)
CODEOPS_LLM_PROVIDER=mock

# OpenAI-compatible settings (works with OpenAI, DeepSeek, Qwen/DashScope, Ollama, vLLM)
CODEOPS_API_KEY=
CODEOPS_BASE_URL=https://api.openai.com/v1
CODEOPS_MODEL=gpt-4o-mini

# Optional embedding endpoint (if unset, uses built-in local char-ngram + token vector embedder)
CODEOPS_EMBEDDING_MODEL=

# Context & Agent Runtime Budgets
CODEOPS_MAX_STEPS=8
CODEOPS_MAX_TOOL_OUTPUT_CHARS=2400
CODEOPS_CONTEXT_TOKEN_BUDGET=12000
CODEOPS_SANDBOX_TIMEOUT_SECONDS=10

# Persistence & Observability
CODEOPS_STATE_DB=.codeops_state.db
CODEOPS_TRACE_DIR=.codeops_traces

# Optional LangFuse export
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
